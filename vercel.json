{
  "rewrites": [
    {
      "source": "/adm",
      "destination": "/index.html"
    },
    {
      "source": "/adm/",
      "destination": "/index.html"
    },
    {
      "source": "/trilhas",
      "destination": "/index.html"
    },
    {
      "source": "/trilhas/",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/adm",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/adm.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        }
      ]
    },
    {
      "source": "/adm-sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    }
  ]
}