{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/trilhas",
      "destination": "/index.html"
    },
    {
      "source": "/adm",
      "destination": "/index.html"
    },
    {
      "source": "/adm/",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/adm",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}